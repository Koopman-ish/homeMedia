# ═══════════════════════════════════════════════════════════════
# .gitignore — Koopman Homelab
# ═══════════════════════════════════════════════════════════════

# ── Secrets & Credentials ────────────────────────────────────────
.env
.env.*
!.env.example

# API keys and tokens
*.key
*.pem
*.crt
*.p12
*.pfx
auth.json

# ── Certificates ─────────────────────────────────────────────────
networking/config/traefik/certs/
**/certs/*.pem
**/certs/*.key

# ── Service Config Data (runtime generated) ──────────────────────
# Authentik
security/config/authentik/
security/config/crowdsec/data/
security/config/fail2ban/fail2ban/fail2ban.sqlite3

# Nextcloud
nas/config/nextcloud/
!nas/config/nextcloud/.gitkeep

# Immich ML cache
nas/config/immich/ml-cache/

# Grafana data
monitoring/config/grafana/provisioning/dashboards/*.json

# qBittorrent
media/config/qbittorrent/qBittorrent/

# Hermes
ai/config/hermes/config.yaml
ai/config/hermes-josh/config.yaml
ai/config/hermes-family/config.yaml
ai/config/hermes*/sessions/
ai/config/hermes*/memories/
ai/config/hermes*/logs/
ai/config/hermes*/kanban.db*
ai/config/hermes*/state.db*
ai/config/hermes*/models_dev_cache.json
ai/config/hermes*/ollama_cloud_models_cache.json
ai/config/hermes*/gateway_state.json
ai/config/hermes*/.cache/
ai/config/hermes*/auth.json
ai/config/hermes*/auth.lock
ai/config/hermes*/channel_directory.json

# Hermes source (large, cloned separately)
ai/hermes-src/

# Ollama models (large)
ai/config/ollama/

# n8n
ai/config/n8n/

# ── Logs ─────────────────────────────────────────────────────────
networking/logs/
**/*.log
**/logs/

# ── Database files ───────────────────────────────────────────────
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ── OS & Editor ──────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ── Docker ───────────────────────────────────────────────────────
# Keep compose files but ignore runtime data
**/config/**/*.json
!**/config/homepage/*.yaml
!**/config/prometheus/*.yml
!**/config/loki/*.yml
!**/config/promtail/*.yml
!**/config/grafana/provisioning/datasources/*.yml

# ── Backup files ─────────────────────────────────────────────────
*.bak
*.backup
*.old
