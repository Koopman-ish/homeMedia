# ═══════════════════════════════════════════════════════════════
# .env.example — Koopman Homelab
# Copy to .env and fill in all values before starting
# NEVER commit .env to git
# ═══════════════════════════════════════════════════════════════

# ── General ──────────────────────────────────────────────────────
TZ=Africa/Johannesburg
PUID=1000
PGID=1000
DOMAIN=homelab.lan
CONFIG_ROOT=/opt/containers
MEDIA_ROOT=/mnt/media

# ── Authentik ────────────────────────────────────────────────────
AUTHENTIK_SECRET_KEY=
AUTHENTIK_POSTGRES_PASSWORD=
AUTHENTIK_POSTGRES_USER=authentik
AUTHENTIK_POSTGRES_DB=authentik

# ── Nextcloud ────────────────────────────────────────────────────
NEXTCLOUD_POSTGRES_PASSWORD=
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=

# ── Immich ───────────────────────────────────────────────────────
IMMICH_POSTGRES_PASSWORD=

# ── Grafana ──────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ── VPN ──────────────────────────────────────────────────────────
VPN_PROVIDER=protonvpn
VPN_WIREGUARD_PRIVATE_KEY=
VPN_SERVER_COUNTRY=Netherlands

# ── CrowdSec ─────────────────────────────────────────────────────
CROWDSEC_BOUNCER_API_KEY=
CROWDSEC_ENROLLMENT_KEY=

# ── AI ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
N8N_LICENSE_ACTIVATION_KEY=

# ── *Arr API Keys ────────────────────────────────────────────────
RADARR_API_KEY=
SONARR_API_KEY=
LIDARR_API_KEY=

